{
  "name": "@ngm-dev/mat-exp",
  "version": "2.0.1",
  "description": "Angular Material Expressive is a library that provides a set of components and styles for Angular Material based on the latest Material Design 3 Expressive Design System.",
  "keywords": [
    "angular",
    "material",
    "expressive",
    "design system",
    "components",
    "styles"
  ],
  "author": {
    "name": "Dharmen Shah",
    "url": "https://github.com/shhdharmen"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Angular-Material-Dev/mat-exp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Angular-Material-Dev/mat-exp"
  },
  "homepage": "https://expressive.angular-material.dev/",
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/material": "^22.0.0",
    "gsap": "^3.13.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "license": "MIT",
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "exports": {
    ".": {
      "sass": "./src/lib/styles/_index.scss",
      "types": "./types/ngm-dev-mat-exp.d.ts",
      "default": "./fesm2022/ngm-dev-mat-exp.mjs"
    },
    "./styles.css": {
      "style": "./src/styles/styles.css"
    },
    "./schematics/*": "./schematics/*",
    "./package.json": {
      "default": "./package.json"
    }
  },
  "module": "fesm2022/ngm-dev-mat-exp.mjs",
  "typings": "types/ngm-dev-mat-exp.d.ts",
  "type": "module"
}
